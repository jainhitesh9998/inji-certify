<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.inji.certify</groupId>
        <artifactId>certify-parent</artifactId>
        <version>1.0.0-beta.1-SNAPSHOT</version>
    </parent>
    <artifactId>certify-testkit-mdoc</artifactId>
    <name>certify-testkit-mdoc</name>
    <description>Independent ISO/IEC 18013-5 IssuerSigned verifier for the mDoc tests: Multipaz JVM as the primary
        implementation, Authlete CBOR as a second COSE oracle. Test-only; consume it with scope test
        (docs/design/20-mdl-issuer.md M-01, decision D9).</description>

    <dependencies>
        <!-- Primary verifier: OpenWallet Foundation Multipaz, pinned exactly. The Kotlin stdlib and kotlinx
             dependencies it drags in must stay inside this module; other modules see them only through a
             test-scoped dependency on this artifact. -->        <dependency>
            <groupId>org.multipaz</groupId>
            <artifactId>multipaz-jvm</artifactId>
            <version>${multipaz.version}</version>
            <exclusions>
                <!-- Android key attestation is a runtime dependency of the Android flavour; the JVM verifier
                     never reaches it, and it is not on Maven Central. -->
                <exclusion>
                    <groupId>com.android.keyattestation</groupId>
                    <artifactId>keyattestation</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.multipaz</groupId>
            <artifactId>multipaz-doctypes-jvm</artifactId>
            <version>${multipaz.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-core-jvm</artifactId>
            <version>${multipaz.kotlinx.coroutines.version}</version>
        </dependency>
        <!-- Second COSE oracle, independent of Multipaz. -->
        <dependency>
            <groupId>com.authlete</groupId>
            <artifactId>cbor</artifactId>
            <version>${authlete.cbor.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>10.0.2</version>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- Multipaz is built against Kotlin 2.2.21; Spring Boot 3.2's BOM would pin the stdlib to 1.9.22,
                 which has no kotlin.time.Instant. The override is local to this module on purpose. -->
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>${multipaz.kotlin.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
