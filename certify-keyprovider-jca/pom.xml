<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.inji.certify</groupId>
        <artifactId>certify-parent</artifactId>
        <version>1.0.0-beta.1-SNAPSHOT</version>
    </parent>
    <artifactId>certify-keyprovider-jca</artifactId>
    <name>certify-keyprovider-jca</name>
    <description>KeyProvider over a PKCS#12 keystore or PEM files, with a dev mode that generates keys and self-signed certificates at startup. Needs no keymanager tables (see docs/design/06a-x509-pki-and-mdoc.md).</description>

    <dependencies>
        <dependency>
            <groupId>io.inji.certify</groupId>
            <artifactId>certify-signing</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Nimbus' Ed25519Verifier delegates to Tink; tests verify EdDSA JWS with Nimbus as an independent verifier -->
            <groupId>com.google.crypto.tink</groupId>
            <artifactId>tink</artifactId>
            <version>1.13.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
