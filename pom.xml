		<java.version>21</java.version>
		<jose4j.version>0.6.5</jose4j.version>
		<kernel.core.version>1.3.0-beta.1</kernel.core.version>
		<kernel.keymanager.version>1.4.0</kernel.keymanager.version>
		<jsonld.common.java.version>0.5.0</jsonld.common.java.version>
		<springdoc-openapi-webmvc-ui-version>2.5.0</springdoc-openapi-webmvc-ui-version>
		<commons.validator.version>1.7</commons.validator.version>
		<google.guava.version>18.0</google.guava.version>
		<!-- Docker Engine 29 dropped API versions below 1.44; the Testcontainers managed by Boot 3.2 (1.19.5) cannot talk to it -->
		<testcontainers.version>1.21.4</testcontainers.version>
		<!-- independent mDoc verifier (M-01, decision D9): pinned exactly, test-only module -->
		<multipaz.version>0.102.0</multipaz.version>
		<!-- Kotlin 2.2.21 is what Multipaz is built against; Spring Boot's BOM pins the repository to 1.9.22 -->
		<multipaz.kotlin.version>2.2.21</multipaz.kotlin.version>
		<multipaz.kotlinx.coroutines.version>1.10.2</multipaz.kotlinx.coroutines.version>
		<authlete.cbor.version>1.19</authlete.cbor.version>
		<!-- One BouncyCastle release for the PKI profiles, the signing library and the providers -->
		<bouncycastle.version>1.78.1</bouncycastle.version>
		<!-- Docker Engine 28+ validates the Host header on the unix socket; docker-java below 3.5 is rejected with 400 -->
		<docker-java.version>3.5.3</docker-java.version>
	</properties>

