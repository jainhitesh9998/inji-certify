{
    "@context": [
        "https://www.w3.org/2018/credentials/v1",
        "https://w3id.org/security/suites/ed25519-2020/v1",
        {
            "GoldenQrCredential": "https://example.org/golden#GoldenQrCredential",
            "fullName": "https://schema.org/name",
            "dateOfBirth": "https://schema.org/birthDate",
            "city": "https://schema.org/addressLocality",
            "qr": "https://example.org/golden#qr"
        }
    ],
    "issuer": "${_issuer}",
    "type": ["VerifiableCredential", "GoldenQrCredential"],
    "issuanceDate": "${validFrom}",
    "expirationDate": "${validUntil}",
    "credentialSubject": {
        "id": "${_holderId}",
        "fullName": "${fullName}",
        "dateOfBirth": "${dateOfBirth}",
        "city": "${city}",
        "qr": "$claim_169_values.get(0)"
    }
}
