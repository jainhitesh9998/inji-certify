{
    "@context": [
        "https://www.w3.org/ns/credentials/v2",
        {
            "GoldenCredential": "https://example.org/golden#GoldenCredential",
            "fullName": "https://schema.org/name",
            "dateOfBirth": "https://schema.org/birthDate",
            "city": "https://schema.org/addressLocality"
        }
    ],
    "issuer": "${_issuer}",
    "type": ["VerifiableCredential", "GoldenCredential"],
    "validFrom": "${validFrom}",
    "validUntil": "${validUntil}",
    "credentialSubject": {
        "id": "${_holderId}",
        "fullName": "${fullName}",
        "dateOfBirth": "${dateOfBirth}",
        "city": "${city}"
    }
}
