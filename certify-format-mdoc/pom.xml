<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.inji.certify</groupId>
        <artifactId>certify-parent</artifactId>
        <version>1.0.0-beta.1-SNAPSHOT</version>
    </parent>
    <artifactId>certify-format-mdoc</artifactId>
    <name>certify-format-mdoc</name>
    <description>CredentialFormatter for mso_mdoc (ISO/IEC 18013-5): IssuerSigned with salted namespace items, the MSO and the IssuerAuth COSE_Sign1 through certify-signing (docs/design/05-target-architecture.md).</description>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo1.maven.org/maven2</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.inji.certify</groupId>
            <artifactId>certify-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.inji.certify</groupId>
            <artifactId>certify-signing</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>co.nstant.in</groupId>
            <artifactId>cbor</artifactId>
            <version>0.9</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.inji.certify</groupId>
            <artifactId>certify-keyprovider-jca</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- independent mDoc verifier (M-01): test-only, and the Kotlin runtime Multipaz needs is pinned to
             Multipaz's version because Spring Boot's BOM would otherwise select 1.9.22 (no kotlin.time.Instant). -->
        <dependency>
            <groupId>io.inji.certify</groupId>
            <artifactId>certify-testkit-mdoc</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${multipaz.kotlin.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
